# Python environments (one shared environment lives in .venvs/export, see README.md)
.venvs/
**/.venv/
**/__pycache__/

# Export outputs: model files, manifests, logs. They are published on Hugging Face,
# never committed (large, and some models belong to collaborators). No trailing slash, so a
# link to the SSD copy (ln -s .../<tool>/out <tool>/out) is ignored too.
**/out
*.log

# Model weights anywhere in the tree
*.tflite
*.mlpackage
*.mlmodel
*.pt
*.pth
*.onnx
*.npy

# Tables are usually outputs; the hand-checked taxonomy tables are the exception
*.csv
!**/taxa/*.csv

# Claude Code's own settings and hooks: personal tooling for this laptop's layout.
.claude/

# Local files, parked ideas, etc.
parked/
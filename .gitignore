# Python environments (one shared environment lives in .venvs/export, see README.md)
.venvs/
**/.venv/
**/__pycache__/

# Export outputs: model files, manifests, logs. They are published on Hugging Face,
# never committed (large, and some models belong to collaborators). No trailing slash, so a
# link to the SSD copy (ln -s .../<tool>/out <tool>/out) is ignored too.
**/out
*.log
# The same layout as <tool>/out, kept on the laptop while the SSD is not connected; copy into
# out/ when it is (cp -rn bioclip_export/out_laptop/. bioclip_export/out/).
**/out_laptop

# Model weights anywhere in the tree
*.tflite
*.mlpackage
*.mlmodel
*.pt
*.pth
*.onnx
*.npy

# Tables are usually outputs; the hand-checked taxonomy tables, the neighbour table
# (copied into label packs) and the species sets of photo_test.py are the exceptions
*.csv
!**/taxa/*.csv
!bioclip_export/country_neighbours.csv
!bioclip_export/photo_sets/*.csv

# Claude Code's own settings and hooks: personal tooling for this laptop's layout.
.claude/

# Local files, parked ideas, etc.
parked/

# Reports and plans that are not public yet (shared with colleagues & collaborators by hand)
private/
